<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.NewBillController"
            style="-fx-background-color: #f4f6f9; -fx-font-family: 'Segoe UI', Helvetica;">
    
    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 20;" alignment="CENTER">
            <Label text="New Bill" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER" style="-fx-padding: 30;">
            <GridPane hgap="15" vgap="15" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 8;" maxWidth="500">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="100"/>
                    <ColumnConstraints halignment="LEFT" minWidth="250" hgrow="ALWAYS"/>
                </columnConstraints>
                
                <Label text="Bill Type:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-size: 14px;"/>
                <TextField fx:id="typeField" promptText="e.g., Electricity, Internet" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-padding: 6;"/>

                <Label text="Amount (€):" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 14px;"/>
                <TextField fx:id="amountField" promptText="e.g., 45.50" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-padding: 6;"/>

                <Label text="Due Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 14px;"/>
                <DatePicker fx:id="datePicker" promptText="Select Date" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity" style="-fx-padding: 3;"/>

                <Label text="Payers:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-size: 14px;"/>
                <TextField fx:id="payersField" promptText="e.g., John, Maria" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-padding: 6;"/>
            </GridPane>

            <HBox spacing="15" alignment="CENTER" maxWidth="500">
                <Button text="Cancel" onAction="#handleCancel"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button text="Create Bill" onAction="#handleCreateBill"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>